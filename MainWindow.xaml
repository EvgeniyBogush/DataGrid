<Window
    x:Class="EnecaDataGrid.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:grid="clr-namespace:EnecaDataGrid.Controls"
    xmlns:local="clr-namespace:EnecaDataGrid"
    Title="EnecaDataGrid"
    Width="1120"
    Height="720"
    MinWidth="820"
    MinHeight="520">
    <Window.Resources>
        <ResourceDictionary>
            <local:BindingProxy x:Key="VmProxy" Data="{Binding}" />
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Background="#F6F8FA">
        <Border
            Padding="16"
            Background="White"
            BorderBrush="{StaticResource GridBorderBrush}"
            BorderThickness="0,0,0,1"
            DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="WPF EnecaDataGrid" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="#57606A"
                        Text="{Binding SelectedOrderSummary}" />
                </StackPanel>

                <TextBox
                    Grid.Column="1"
                    Width="240"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Filter by customer, city, or status" />

                <Button
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    Padding="14,7"
                    VerticalAlignment="Center"
                    Command="{Binding ToggleReadOnlyCommand}"
                    Content="{Binding EditModeButtonText}" />
            </Grid>
        </Border>

        <grid:EnecaDataGrid
            x:Name="OrdersGrid"
            Margin="16"
            CellVisualStateMode="Interactive"
            EnableHeaderSelection="True"
            FilterColumnIndices="2,3"
            FirstColumnIsCheckBoxColumn="True"
            FreezeFirstColumn="True"
            IsReadOnly="{Binding IsGridReadOnly}"
            ItemsSource="{Binding OrdersView}"
            SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
            Style="{StaticResource EnecaDataGridStyle}">
            <grid:EnecaDataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding PlacementTarget.DataContext.DuplicateSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Duplicate selected row" />
                    <MenuItem Command="{Binding PlacementTarget.DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Header="Delete selected row" />
                </ContextMenu>
            </grid:EnecaDataGrid.ContextMenu>

            <grid:EnecaDataGrid.Columns>
                <DataGridTextColumn
                    Width="90"
                    Binding="{Binding OrderId}"
                    Header="{Binding Data.OrderIdFilter, Source={StaticResource VmProxy}}"
                    IsReadOnly="True" />
                <DataGridTextColumn
                    Width="180"
                    Binding="{Binding Customer, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                    Header="{Binding Data.CustomerFilter, Source={StaticResource VmProxy}}" />
                <DataGridTextColumn
                    Width="140"
                    Binding="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                    Header="{Binding Data.CityFilter, Source={StaticResource VmProxy}}" />
                <DataGridTextColumn
                    Width="130"
                    Binding="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                    Header="{Binding Data.StatusFilter, Source={StaticResource VmProxy}}" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding DueDate, StringFormat=d, UpdateSourceTrigger=PropertyChanged}"
                    Header="{Binding Data.DueDateFilter, Source={StaticResource VmProxy}}" />
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding Amount, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                    Header="{Binding Data.AmountFilter, Source={StaticResource VmProxy}}" />
                <DataGridCheckBoxColumn
                    Width="90"
                    Binding="{Binding IsActive, UpdateSourceTrigger=PropertyChanged}"
                    Header="{Binding Data.ActiveFilter, Source={StaticResource VmProxy}}" />
                <DataGridTemplateColumn
                    Width="180"
                    Header="{Binding Data.ValidationFilter, Source={StaticResource VmProxy}}"
                    IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{StaticResource GridErrorBrush}"
                                Text="{Binding ValidationMessage}"
                                TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </grid:EnecaDataGrid.Columns>
        </grid:EnecaDataGrid>
    </DockPanel>
</Window>
