<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:EnecaDataGrid.Controls"
    xmlns:local="clr-namespace:EnecaDataGrid"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <SolidColorBrush x:Key="EnecaDataGridBackgroundBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="EnecaDataGridHeaderBackgroundBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="EnecaDataGridHeaderInteractiveBackgroundBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="EnecaDataGridHeaderActiveBackgroundBrush" Color="#DCEFEB" />
    <SolidColorBrush x:Key="EnecaDataGridHeaderTextBrush" Color="#828282" />
    <SolidColorBrush x:Key="EnecaDataGridHeaderTextActiveBrush" Color="#155144" />
    <SolidColorBrush x:Key="EnecaDataGridHeaderTextPressedBrush" Color="#86C3B7" />
    <SolidColorBrush x:Key="EnecaDataGridHeaderTextDisabledBrush" Color="#BDBDBD" />
    <SolidColorBrush x:Key="EnecaDataGridHeaderSeparatorBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="EnecaDataGridRowBackgroundBrush" Color="#FDFDFD" />
    <SolidColorBrush x:Key="EnecaDataGridRowTextBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="EnecaDataGridRowHoverBackgroundBrush" Color="#DCEFEB" />
    <SolidColorBrush x:Key="EnecaDataGridRowPressedForegroundBrush" Color="#86C3B7" />
    <SolidColorBrush x:Key="EnecaDataGridRowDisabledForegroundBrush" Color="#BDBDBD" />
    <SolidColorBrush x:Key="EnecaDataGridRowSeparatorBrush" Color="#E6E6E6" />

    <SolidColorBrush x:Key="GridHeaderBackground" Color="#E6E6E6" />
    <SolidColorBrush x:Key="GridHeaderForeground" Color="#828282" />
    <SolidColorBrush x:Key="GridBorderBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="GridErrorBrush" Color="#B42318" />
    <SolidColorBrush x:Key="GridSelectedBackground" Color="#DCEFEB" />
    <SolidColorBrush x:Key="GridFilterActiveBrush" Color="#155144" />

    <sys:Double x:Key="EnecaDataGridFilterPopupOptionsMaxHeight">220</sys:Double>

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <Style
        x:Key="HeaderInteractiveTextStyle"
        TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Montserrat, Segoe UI, Arial" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource EnecaDataGridHeaderTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type DataGridColumnHeader}}}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource EnecaDataGridHeaderTextDisabledBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type DataGridColumnHeader}}}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource EnecaDataGridHeaderTextActiveBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridColumnHeader}}, Path=(controls:EnecaDataGrid.IsPressed)}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource EnecaDataGridHeaderTextPressedBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridColumnHeader}}, Path=(controls:EnecaDataGrid.IsClicked)}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource EnecaDataGridHeaderTextActiveBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="EnecaDataGridColumnHeaderTemplate">
        <Border
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{StaticResource EnecaDataGridHeaderInteractiveBackgroundBrush}">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource HeaderInteractiveTextStyle}" Text="{Binding Title}" />

                <controls:ColumnFilterPopup
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridColumnHeader}}, Path=(controls:EnecaDataGrid.IsFilterVisible), Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed, TargetNullValue=Collapsed}" />
            </Grid>
        </Border>
    </DataTemplate>

    <Style x:Key="EnecaDataGridControlStyle" TargetType="{x:Type controls:EnecaDataGrid}">
        <Setter Property="Background" Value="{StaticResource EnecaDataGridBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="HorizontalGridLinesBrush" Value="Transparent" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="RowBackground" Value="{StaticResource EnecaDataGridRowBackgroundBrush}" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EnecaDataGrid}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True">
                        <DockPanel LastChildFill="True">
                            <Border
                                Margin="0,0,0,8"
                                DockPanel.Dock="Top"
                                Style="{DynamicResource EnecaDataGridHeaderShellStyle}">
                                <DataGridColumnHeadersPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                            <ScrollViewer
                                Focusable="False"
                                BorderThickness="0"
                                Padding="0">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EnecaDataGridColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource EnecaDataGridHeaderTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                        <Thumb
                            x:Name="PART_LeftHeaderGripper"
                            Width="0"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            Cursor="Arrow" />
                        <Thumb
                            x:Name="PART_RightHeaderGripper"
                            Width="24"
                            Margin="0,0,-9,0"
                            HorizontalAlignment="Right"
                            Panel.ZIndex="2"
                            Background="Transparent"
                            Cursor="None"
                            controls:EnecaDataGrid.ResizeThumbIconSource="{StaticResource wide_horizontal_Icon_wide_horizontalDrawingImage}"
                            controls:EnecaDataGrid.ResizeThumbIconIsEnabled="True"
                            Template="{DynamicResource EnecaColumnResizeThumbTemplate}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(controls:EnecaDataGrid.HideRightSeparator)}" Value="True">
                            <Setter TargetName="PART_RightHeaderGripper" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(controls:EnecaDataGrid.IsCheckBoxHeader)}" Value="True">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </DataTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource EnecaDataGridHeaderActiveBackgroundBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(controls:EnecaDataGrid.IsPressed)}" Value="True">
                <Setter Property="Background" Value="{StaticResource EnecaDataGridHeaderActiveBackgroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(controls:EnecaDataGrid.IsClicked)}" Value="True">
                <Setter Property="Background" Value="{StaticResource EnecaDataGridHeaderActiveBackgroundBrush}" />
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource EnecaDataGridHeaderTextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="EnecaDataGridCheckBoxColumnHeaderStyle"
        TargetType="{x:Type DataGridColumnHeader}"
        BasedOn="{StaticResource EnecaDataGridColumnHeaderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="EnecaDataGridHeaderShellStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource EnecaDataGridHeaderBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style x:Key="EnecaDataGridHeaderSelectionShellStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource EnecaDataGridHeaderInteractiveBackgroundBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="EnecaDataGridHeaderLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Montserrat, Segoe UI, Arial" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource EnecaDataGridHeaderTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="EnecaDataGridHeaderFilterIconStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="EnecaDataGridCheckAllBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsThreeState" Value="False" />
    </Style>

    <Style x:Key="EnecaDataGridRowShellStyle" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{StaticResource EnecaDataGridRowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource EnecaDataGridRowTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridRow}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        ClipToBounds="True"
                        SnapsToDevicePixels="True">
                        <DataGridCellsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EnecaDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="FontFamily" Value="Montserrat, Segoe UI, Arial" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource EnecaDataGridRowTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Effect" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Border
                            x:Name="PART_RightSeparator"
                            Width="1"
                            Height="24"
                            Margin="0,4,0,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="{StaticResource EnecaDataGridRowSeparatorBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(controls:EnecaDataGrid.HideRightSeparator)}" Value="True">
                            <Setter TargetName="PART_RightSeparator" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource EnecaDataGridRowBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource EnecaDataGridRowDisabledForegroundBrush}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource EnecaDataGridRowHoverBackgroundBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(controls:EnecaDataGrid.IsPressed)}" Value="True">
                <Setter Property="Background" Value="{StaticResource EnecaDataGridRowHoverBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource EnecaDataGridRowPressedForegroundBrush}" />
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource EnecaDataGridRowHoverBackgroundBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding CellVisualStateMode, RelativeSource={RelativeSource AncestorType={x:Type controls:EnecaDataGrid}}}" Value="{x:Static local:CellVisualStateMode.AlwaysDefault}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource EnecaDataGridRowTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EnecaDataGridRowTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Montserrat, Segoe UI, Arial" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource EnecaDataGridRowTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="EnecaDataGridCellCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="EnecaDataGridRowSeparatorStyle" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="Background" Value="{StaticResource EnecaDataGridRowSeparatorBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <ControlTemplate x:Key="EnecaColumnResizeThumbTemplate" TargetType="{x:Type Thumb}">
        <Grid
            Height="24"
            Margin="0,4,0,4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="Transparent">
            <Border
                Width="1"
                Height="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource EnecaDataGridHeaderSeparatorBrush}" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="EnecaDataGridColumnHeaderStyleCustom"
           TargetType="{x:Type DataGridColumnHeader}"
           BasedOn="{StaticResource EnecaDataGridColumnHeaderStyle}">
        <Setter Property="ContentTemplate" Value="{StaticResource EnecaDataGridColumnHeaderTemplate}" />
        <Setter Property="Foreground" Value="{StaticResource GridHeaderForeground}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style x:Key="EnecaDataGridCellStyleCustom"
           TargetType="{x:Type DataGridCell}"
           BasedOn="{StaticResource EnecaDataGridCellStyle}">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="EnecaDataGridRowStyleCustom"
           TargetType="{x:Type DataGridRow}"
           BasedOn="{StaticResource EnecaDataGridRowShellStyle}">
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                <Setter Property="ToolTip" Value="{Binding ValidationMessage}" />
                <Setter Property="BorderBrush" Value="{StaticResource GridErrorBrush}" />
                <Setter Property="BorderThickness" Value="2,0,0,0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EnecaDataGridStyle"
           TargetType="{x:Type controls:EnecaDataGrid}"
           BasedOn="{StaticResource EnecaDataGridControlStyle}">
        <Setter Property="Background" Value="#F5F5F5" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="True" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CanUserSortColumns" Value="False" />
        <Setter Property="CellStyle" Value="{StaticResource EnecaDataGridCellStyleCustom}" />
        <Setter Property="ColumnHeaderHeight" Value="32" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource EnecaDataGridColumnHeaderStyleCustom}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="36" />
        <Setter Property="RowStyle" Value="{StaticResource EnecaDataGridRowStyleCustom}" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="Cell" />
    </Style>

    <Style x:Key="EnecaDataGridHeaderFilterToggleStyle"
           TargetType="{x:Type ToggleButton}"
           BasedOn="{StaticResource EnecaDataGridHeaderFilterIconStyle}">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="EnecaDataGridFilterPopupBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="260" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource GridBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="EnecaDataGridFilterPopupTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#0B1F33" />
    </Style>

    <Style x:Key="EnecaDataGridFilterPopupSummaryStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,3,0,8" />
        <Setter Property="Foreground" Value="#57606A" />
    </Style>

    <Style x:Key="EnecaDataGridFilterPopupActionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style x:Key="EnecaDataGridFilterOptionCheckBoxStyle"
           TargetType="{x:Type CheckBox}"
           BasedOn="{StaticResource EnecaDataGridCheckAllBoxStyle}">
        <Setter Property="Margin" Value="0,3" />
    </Style>
</ResourceDictionary>
