<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:EnecaDataGrid.Controls"
    xmlns:local="clr-namespace:EnecaDataGrid">
    <SolidColorBrush x:Key="EnecaDataGridBackgroundBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="EnecaDataGridHeaderBackgroundBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="EnecaDataGridHeaderInteractiveBackgroundBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="EnecaDataGridHeaderActiveBackgroundBrush" Color="#DCEFEB" />
    <SolidColorBrush x:Key="EnecaDataGridHeaderTextBrush" Color="#828282" />
    <SolidColorBrush x:Key="EnecaDataGridHeaderTextActiveBrush" Color="#155144" />
    <SolidColorBrush x:Key="EnecaDataGridHeaderTextPressedBrush" Color="#86C3B7" />
    <SolidColorBrush x:Key="EnecaDataGridHeaderTextDisabledBrush" Color="#BDBDBD" />
    <SolidColorBrush x:Key="EnecaDataGridHeaderSeparatorBrush" Color="#F5F5F5" />
    <SolidColorBrush x:Key="EnecaDataGridRowBackgroundBrush" Color="#FDFDFD" />
    <SolidColorBrush x:Key="EnecaDataGridRowTextBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="EnecaDataGridRowSeparatorBrush" Color="#E6E6E6" />

    <Style x:Key="EnecaDataGridControlStyle" TargetType="{x:Type controls:EnecaDataGrid}">
        <Setter Property="Background" Value="{StaticResource EnecaDataGridBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="HorizontalGridLinesBrush" Value="Transparent" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="RowBackground" Value="{StaticResource EnecaDataGridRowBackgroundBrush}" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:EnecaDataGrid}">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <DockPanel LastChildFill="True">
                            <DataGridColumnHeadersPresenter
                                Margin="0,0,0,8"
                                DockPanel.Dock="Top"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <ScrollViewer Focusable="False">
                                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EnecaDataGridColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{StaticResource EnecaDataGridHeaderBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource EnecaDataGridHeaderTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Grid Background="{TemplateBinding Background}">
                        <Thumb
                            x:Name="PART_LeftHeaderGripper"
                            Width="0"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            Cursor="Arrow" />
                        <Thumb
                            x:Name="PART_RightHeaderGripper"
                            Width="24"
                            Margin="0,0,-9,0"
                            HorizontalAlignment="Right"
                            Panel.ZIndex="2"
                            Background="Transparent"
                            Cursor="None"
                            controls:ResizeThumbIconBehavior.IconSource="{StaticResource wide_horizontal_Icon_wide_horizontalDrawingImage}"
                            controls:ResizeThumbIconBehavior.IsEnabled="True"
                            Template="{DynamicResource EnecaColumnResizeThumbTemplate}" />
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(controls:ColumnHeaderState.HideRightSeparator)}" Value="True">
                            <Setter TargetName="PART_RightHeaderGripper" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(controls:ColumnHeaderState.IsCheckBoxHeader)}" Value="True">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </DataTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource EnecaDataGridHeaderActiveBackgroundBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(controls:ColumnHeaderState.IsPressed)}" Value="True">
                <Setter Property="Background" Value="{StaticResource EnecaDataGridHeaderActiveBackgroundBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(controls:ColumnHeaderState.IsClicked)}" Value="True">
                <Setter Property="Background" Value="{StaticResource EnecaDataGridHeaderActiveBackgroundBrush}" />
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource EnecaDataGridHeaderTextDisabledBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style
        x:Key="EnecaDataGridCheckBoxColumnHeaderStyle"
        TargetType="{x:Type DataGridColumnHeader}"
        BasedOn="{StaticResource EnecaDataGridColumnHeaderStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="EnecaDataGridHeaderShellStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource EnecaDataGridHeaderBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style x:Key="EnecaDataGridHeaderSelectionShellStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource EnecaDataGridHeaderInteractiveBackgroundBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="EnecaDataGridHeaderLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Montserrat, Segoe UI, Arial" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource EnecaDataGridHeaderTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="EnecaDataGridHeaderFilterIconStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="EnecaDataGridCheckAllBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsThreeState" Value="False" />
    </Style>

    <Style x:Key="EnecaDataGridRowShellStyle" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="{StaticResource EnecaDataGridRowBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource EnecaDataGridRowTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="EnecaDataGridCellStyle" TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="{StaticResource EnecaDataGridRowTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{StaticResource EnecaDataGridRowBackgroundBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Effect" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Grid Background="{TemplateBinding Background}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Border
                            Width="1"
                            Height="24"
                            Margin="0,4,0,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="{StaticResource EnecaDataGridRowSeparatorBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource EnecaDataGridHeaderActiveBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource EnecaDataGridHeaderTextActiveBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource EnecaDataGridHeaderActiveBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource EnecaDataGridHeaderTextActiveBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="{StaticResource EnecaDataGridHeaderActiveBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource EnecaDataGridHeaderTextActiveBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding CellVisualStateMode, RelativeSource={RelativeSource AncestorType={x:Type controls:EnecaDataGrid}}}" Value="{x:Static local:CellVisualStateMode.AlwaysDefault}">
                <Setter Property="Background" Value="{StaticResource EnecaDataGridRowBackgroundBrush}" />
                <Setter Property="Foreground" Value="{StaticResource EnecaDataGridRowTextBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EnecaDataGridRowTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Montserrat, Segoe UI, Arial" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource EnecaDataGridRowTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="EnecaDataGridCellCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="EnecaDataGridRowSeparatorStyle" TargetType="{x:Type Border}">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="Background" Value="{StaticResource EnecaDataGridRowSeparatorBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <ControlTemplate x:Key="EnecaColumnResizeThumbTemplate" TargetType="{x:Type Thumb}">
        <Grid
            Height="24"
            Margin="0,4,0,4"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="Transparent">
            <Border
                Width="1"
                Height="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource EnecaDataGridHeaderSeparatorBrush}" />
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
