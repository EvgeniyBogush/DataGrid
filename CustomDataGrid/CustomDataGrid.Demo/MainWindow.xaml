<Window x:Class="Eneca.CustomDataGrid.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:grid="clr-namespace:Eneca.CustomDataGrid.Controls;assembly=Eneca.CustomDataGrid"
        Title="Eneca Custom DataGrid — Demo"
        Width="960" Height="640"
        Background="#FFFFFF"
        FontFamily="Montserrat, Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Демо кастомного DataGrid"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="#1B1B1B"
                   Margin="0,0,0,16" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <CheckBox x:Name="FreezeFirstColumnCheck"
                      Content="Заморозить первый столбец (FreezeFirstColumn)"
                      Margin="0,0,24,0"
                      VerticalAlignment="Center"
                      Checked="OnOptionChanged"
                      Unchecked="OnOptionChanged" />
            <CheckBox x:Name="CheckboxColumnCheck"
                      Content="Первый столбец — чекбоксы (FirstColumnIsCheckBoxColumn)"
                      VerticalAlignment="Center"
                      Checked="OnOptionChanged"
                      Unchecked="OnOptionChanged" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="#F5F5F5"
                CornerRadius="12"
                Padding="8">
            <grid:EnecaDataGrid x:Name="DataGrid"
                                FreezeFirstColumn="False"
                                FirstColumnIsCheckBoxColumn="False"
                                FilterColumnIndices="2,3"
                                EnableHeaderSelection="True" />
        </Border>
    </Grid>
</Window>
